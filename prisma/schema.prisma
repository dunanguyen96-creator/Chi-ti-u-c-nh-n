// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id          String   @id @default(cuid())
  date        DateTime
  recordMonth String
  description String
  category    String
  card        String?
  note        String?
  amount      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@index([recordMonth])
}

model Income {
  id        String   @id @default(cuid())
  month     String
  amount    Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([month])
}

model CategoryBaseline {
  id        String   @id @default(cuid())
  month     String
  category  String
  amount    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, category])
}

model CreditCard {
  id                   String          @id @default(cuid())
  name                 String          @unique
  cardLimit            Int?
  installmentAmount    Int?
  installmentTerm      String?
  statementClosingDay  Int?
  paymentDueDay        Int?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  statements           CardStatement[]
  payments             CardPayment[]
}

model CardStatement {
  id        String     @id @default(cuid())
  cardId    String
  card      CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  date      DateTime
  balance   Int
  createdAt DateTime   @default(now())

  @@index([cardId])
}

model CardPayment {
  id        String     @id @default(cuid())
  cardId    String
  card      CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  date      DateTime
  amount    Int
  createdAt DateTime   @default(now())

  @@index([cardId])
}
