// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id          String   @id @default(cuid())
  date        DateTime
  recordMonth String
  description String
  category    String
  card        String?
  note        String?
  amount      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@index([recordMonth])
}

model Income {
  id        String   @id @default(cuid())
  month     String
  amount    Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([month])
}

model CategoryBaseline {
  id        String   @id @default(cuid())
  month     String
  category  String
  amount    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, category])
}

model CardBaseline {
  id        String   @id @default(cuid())
  month     String
  card      String
  amount    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, card])
}

model CardPaymentBaseline {
  id        String   @id @default(cuid())
  month     String
  card      String
  amount    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, card])
}

model Installment {
  id            String   @id @default(cuid())
  card          String
  totalAmount   Int
  startMonth    String
  endMonth      String
  monthlyAmount Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([card])
}

model Loan {
  id             String   @id @default(cuid())
  description    String
  loanDate       DateTime
  termMonths     Int
  interestRate   Float
  monthlyPayment Int
  // Day of month (1-28, to stay valid every month) the payment is due —
  // used to compute the next upcoming due date for the reminder popup.
  paymentDay     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CreditCard {
  id          String          @id @default(cuid())
  name        String          @unique
  // Set only for overdraft-style accounts (e.g. "Mycash thấu chi") that have
  // no statement cycle: when present, the card shows Hạn mức/Dư nợ/Khả dụng
  // instead of Sao kê, and payments subtract straight from Dư nợ.
  creditLimit Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  statements  CardStatement[]
  payments    CardPayment[]
}

model CardStatement {
  id        String        @id @default(cuid())
  cardId    String
  card      CreditCard    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  date      DateTime
  balance   Int
  dueDate   DateTime?
  createdAt DateTime      @default(now())
  payments  CardPayment[]

  @@index([cardId])
}

model CardPayment {
  id          String         @id @default(cuid())
  cardId      String
  card        CreditCard     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  statementId String?
  statement   CardStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)
  date        DateTime
  amount      Int
  createdAt   DateTime       @default(now())

  @@index([cardId])
  @@index([statementId])
}
